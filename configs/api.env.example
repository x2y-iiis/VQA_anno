# Copy this file to configs/api.env, fill in values locally, and never commit it.

# Downstream provider: las, ark, or dashscope. The production LAS mode uses
# LAS Submit/Poll and injects the customer Ark key into the operator request.
export API_PROVIDER=las
export API_KEY_ENV=LAS_API_KEY
export API_ENDPOINT=https://operator.las.cn-beijing.volces.com/api/v1/submit
export REQUEST_WORKERS=64
export ANNOTATION_PYTHON=python3

# Optional high-concurrency profile. Start conservatively and raise these only
# after observing durable throughput, memory, media preparation, and provider
# rate-limit counters.
export HTTP_CONCURRENCY=2048
export FRAME_WORKERS=512
export VIDEO_WORKERS=64
export LAS_REQUEST_WORKERS=2048
export LAS_OPERATOR_CONCURRENCY=2048
export MEDIA_WORKERS=32
export CLIP_WORKERS=64
export BATCH_WORKERS=16
export MAX_PENDING=4096
export RESUME_VALIDATION_WORKERS=16
export DURABLE_WRITE_WORKERS=128
export REQUEST_MEMORY_MIB=49152
export THREAD_STACK_KIB=256
export REQUEST_START_INTERVAL=0.005
export FIXED_HTTP_CONCURRENCY=1

# Provider credentials.
export ARK_API_KEY=replace_me
export DASHSCOPE_API_KEY=replace_me
export LAS_API_KEY=replace_me

# Vendored Subtask LAS needs a remotely readable video URL. Configure exactly
# one method for that stage.
export LAS_COS_URI_PREFIX=cos://your-bucket/vqa-annotation/las-videos
# export LAS_VIDEO_URL_TEMPLATE='https://example.invalid/videos/{sha256}.mp4'
export LAS_COSCLI=coscli

# Required when CPA uses the default LAS contact-point backend.
export CPA_LAS_COS_PREFIX=cos://your-bucket/vqa-annotation/cpa-images

# Local model repositories and checkpoints used only by CPA.
export SAM3_REPO=/path/to/sam3
export SAM3_CHECKPOINT=/path/to/sam3.pt
export COTRACKER_REPO=/path/to/co-tracker
export COTRACKER_CHECKPOINT=/path/to/scaled_offline.pth

# COS-presigned media for the customer-Ark LAS operator and optional direct
# durable output. The CLI reads credentials from the existing coscli profile.
export VQA_COS_BUCKET=your-bucket
export VQA_COS_ENDPOINT=https://cos.ap-shanghai.myqcloud.com
export VQA_COS_REGION=ap-shanghai
export VQA_COS_IMAGE_PREFIX=vqa-annotation/ecot-target-images
export VQA_COS_VIDEO_PREFIX=vqa-annotation/ecot-videos
export VQA_LAS_OPERATOR_VIDEO_PREFIX=vqa-annotation/las-operator-videos
# export VQA_COS_MOUNT_ROOT=/path/to/writable/cos/mount
# export VQA_COS_OUTPUT_PREFIX=annotations
