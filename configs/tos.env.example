# Credentials with write/delete access to the configured prefix.
export TOS_ACCESS_KEY=''
export TOS_SECRET_KEY=''
# Optional when using temporary STS credentials.
export TOS_SECURITY_TOKEN=''

# The bucket must be readable by the LAS long-video operator.
export TOS_BUCKET=''
export TOS_REGION='cn-beijing'
export TOS_ENDPOINT='tos-cn-beijing.volces.com'
export TOS_PREFIX='video-cleaning/vqa-las-customer-ark-inputs'
export TOS_LAS_VIDEO_URL_MODE='policy-presigned'
# Policy URLs support GET and HEAD. Seven days is the TOS maximum and protects
# LAS tasks that spend hours in the provider queue.
export TOS_POLICY_URL_EXPIRES_SECONDS='604800'

# Alternatively, store one value per private file. These are the defaults used
# by the production launchers and do not need to be exported explicitly.
# TOS_ACCESS_KEY_FILE=/mnt/doubao_las_annotation/.runtime/tos_access_key
# TOS_SECRET_KEY_FILE=/mnt/doubao_las_annotation/.runtime/tos_secret_key
# TOS_SECURITY_TOKEN_FILE=/mnt/doubao_las_annotation/.runtime/tos_security_token
# TOS_BUCKET_FILE=/mnt/doubao_las_annotation/.runtime/tos_bucket
